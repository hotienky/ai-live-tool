# ──── Backend AdonisJS — Docker Environment ────
TZ=Asia/Ho_Chi_Minh
NODE_ENV=development
PORT=3333
HOST=0.0.0.0
APP_KEY=your-app-key-change-me-in-production

# Database — connect to postgres container
DB_CONNECTION=pg
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=ai_live_tool

# Master DB
MASTER_DB_HOST=postgres
MASTER_DB_PORT=5432
MASTER_DB_USER=postgres
MASTER_DB_PASSWORD=postgres
MASTER_DB_DATABASE=master_db

# Redis — connect to redis container
REDIS_HOST=redis
REDIS_PORT=6379

# CORS — allow multi-tenant origins
CORS_ORIGIN=http://localhost,http://master.localhost,http://*.localhost,http://*.cms.localhost

# Session
SESSION_DRIVER=cookie
